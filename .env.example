# Copia este archivo a .env y completa los valores. El .env real nunca se commitea.

# --- Aplicacion -------------------------------------------------------------
APP_ENV=dev                                  # dev | test | prod
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173        # unico origen permitido por CORS

# --- Base de datos ----------------------------------------------------------
# Compose levanta Postgres con pgvector usando estas credenciales.
POSTGRES_USER=asesor
POSTGRES_PASSWORD=asesor
POSTGRES_DB=asesor
POSTGRES_PORT=5432

# DSN async (obligatorio para DatabaseSessionService de ADK). El DSN sincrono
# que usan Alembic y los scripts se deriva solo, cambiando +asyncpg por +psycopg.
# Fuera de Docker, host = localhost; dentro de Compose, host = db.
DATABASE_URL=postgresql+asyncpg://asesor:asesor@localhost:5432/asesor

# --- Seguridad --------------------------------------------------------------
ADMIN_TOKEN=cambia-esto                      # bearer para GET/PATCH /api/v1/handoffs
GUARDRAIL_CANARY_TOKEN=CANARY-CAMBIA-ESTO    # token de fuga inyectado en la instruccion (L4)

# --- Proveedor de LLM -------------------------------------------------------
# Dos perfiles intercambiables. El local no necesita ninguna API key.
LLM_PROVIDER=ollama                          # gemini | ollama

# ===== Perfil A · local con Ollama, todo dentro de Docker (por defecto) ======
# Nada nativo, nada fuera del propio docker-compose.yml: quien clone el repo
# y tenga Docker (nada mas) corre esto y ya, sin instalar Ollama en su maquina:
#   docker compose up -d
# COMPOSE_PROFILES=local-llm (mas abajo) hace que ese comando, sin ningun
# flag, ya incluya el servicio "ollama" y el job que le baja los cuatro
# modelos de abajo (docker-compose.yml, servicio ollama-pull). La primera vez
# tarda lo que tarden esas descargas (varios GB); despues, el volumen los
# conserva y arranca al instante.
#
# El prefijo ollama_chat/ es obligatorio: con ollama/ el modelo entra en loops
# de tool-calling e ignora el contexto.
#
# Los cuatro con tag explicito, nunca :latest: una etiqueta que "flota" puede
# apuntar a una variante distinta el dia que alguien vuelva a levantar el
# proyecto, con otro tamano/capacidades (spec 11). Si cambias alguno, cambia
# tambien el default de OLLAMA_*_MODEL correspondiente en docker-compose.yml,
# para que lo que se hace pull sea lo mismo que la app espera encontrar.
AGENT_MODEL=ollama_chat/gemma4:12b
GUARDRAIL_MODEL=ollama_chat/qwen3:4b-instruct   # pequeno y rapido para el clasificador L2
EVAL_MODEL=ollama_chat/qwen3:4b-instruct
# Distinto del principal a proposito: si el principal falla, el respaldo no
# cae con el. llama3.2 es pequeno y carga rapido.
FALLBACK_MODEL=ollama_chat/llama3.2:3b

COMPOSE_PROFILES=local-llm
# Puerto del host para el Ollama de Docker. Cambialo si ya tienes un Ollama
# propio (nativo, o de otro proyecto) escuchando en el 11434 -es el unico
# ajuste que hace falta para que convivan sin chocar.
OLLAMA_PORT=11434
# Desde el host (scripts como ingest_kb.py) es localhost:OLLAMA_PORT. Dentro
# de Compose, el backend habla con el servicio "ollama" del propio proyecto,
# no con el host: nunca toca un Ollama nativo, aunque haya uno instalado.
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_API_BASE_CONTAINER=http://ollama:11434
# Elige el modelo segun la VRAM REALMENTE LIBRE, no la instalada: el escritorio
# y otras apps pueden ocupar varios GB. Si el modelo no entra, Ollama reparte
# capas a CPU y la latencia se dispara (ver la tabla en ADR-003).
#   docker compose exec ollama ollama ps   -> muestra el reparto CPU/GPU
#
# Alternativa avanzada: usar un Ollama nativo (mejor acceso a GPU en algunos
# equipos) en vez del de Docker. Cambia OLLAMA_API_BASE_CONTAINER a
# http://host.docker.internal:11434 y quita COMPOSE_PROFILES, o levanta sin
# el perfil: `docker compose up -d` (sin la variable) ya no baja nada.
#
# Modelos de mas para el selector, separados por espacio (opcional). NO hace
# falta declararlos en MODEL_CHOICES: el backend los descubre solo contra
# /api/tags al arrancar (spec 11 S3.1). Esta variable solo hace que
# ollama-pull tambien los deje *pulled* para quien clone el repo.
#   OLLAMA_EXTRA_MODELS=mistral:7b llama3.1:8b
OLLAMA_EXTRA_MODELS=
# Ollama recorta el contexto en silencio si no se le dice cuanto usar. Ampliarlo
# agranda el KV cache: con un modelo que ya no entra en VRAM, empeora mucho.
OLLAMA_CONTEXT_LENGTH=32768
# Nivel de razonamiento: low, medium, high, o true/false. Sin valor no se envia.
# Los modelos pequenos con esta capacidad SOLO llaman tools si esta activo, y
# "low" da el mismo tool-calling que "true" a la mitad de latencia (ADR-003).

OLLAMA_THINK=low

# ===== Perfil B · Gemini =====================================================
# Cambia LLM_PROVIDER a gemini, EMBEDDINGS_PROVIDER a gemini, y usa estos IDs
# (verificados contra la documentacion oficial en septiembre de 2026; los IDs de
# Gemini cambian seguido, revisalos antes de desplegar):
#   AGENT_MODEL=gemini-3.8-flash
#   GUARDRAIL_MODEL=gemini-3.5-flash-lite
#   EVAL_MODEL=gemini-3.5-flash
#   FALLBACK_MODEL=gemini-3.7-flash          # de otra generacion a proposito: si el
#                                            # principal da 429, el fallback no cae con el
GOOGLE_API_KEY=                              # requerido si LLM_PROVIDER=gemini y no usas Vertex
GOOGLE_GENAI_USE_VERTEXAI=false              # true para ir por Vertex AI con credenciales de GCP

# ===== Selector de modelos de la interfaz ====================================
# JSON con las opciones del desplegable que NO sean de Ollama (normalmente,
# solo Gemini). Los modelos de Ollama no se declaran aqui: el backend los
# descubre solo contra /api/tags + /api/show en el arranque (infrastructure/
# llm/ollama_discovery.py) y arma esas opciones con sus capacidades reales
# (piensa/usa tools), asi el selector nunca lista un modelo que no este de
# verdad instalado ni se olvida de uno que se acaba de bajar.
# Vacio = una sola opcion (AGENT_MODEL) y el selector no se muestra si
# ademas no hay ningun modelo de Ollama instalado.
# La opcion de Gemini aparece deshabilitada si no hay GOOGLE_API_KEY.
MODEL_CHOICES=[{"id":"gemini","label":"Gemini 3.8 Flash","provider":"gemini","model":"gemini-3.8-flash"}]

# --- Embeddings y RAG -------------------------------------------------------
EMBEDDINGS_PROVIDER=ollama                   # gemini | ollama
EMBEDDINGS_MODEL=embeddinggemma:300m         # 768 dims (gemini: gemini-embedding-001)
# Cambiar de modelo de embeddings obliga a re-ingestar la KB: son espacios
# vectoriales distintos. La app se niega a arrancar si detecta la discrepancia.

# Bajo este score, search_knowledge_base devuelve no_results.
# Calibrado con embeddinggemma sobre la KB real: consultas pertinentes 0.44-0.70,
# ajenas 0.08-0.39. Re-calibrar al cambiar de modelo de embeddings.
RAG_MIN_SCORE=0.42

# --- Memoria ----------------------------------------------------------------
MEMORY_COMPACTION_TOKEN_THRESHOLD=12000      # umbral de tokens antes de compactar eventos
MEMORY_COMPACTION_KEEP_RECENT=6              # eventos recientes que nunca se compactan

# --- Guardrails -------------------------------------------------------------
GUARDRAIL_L2_TIMEOUT_MS=1500                 # si el clasificador tarda mas, fail-open (L4 sigue activo)
MAX_TOOL_CALLS_PER_TURN=4                    # corta loops de tool-calling
ENABLE_FAULT_INJECTION=false                 # header X-Debug-Fault; se ignora si APP_ENV != dev

# --- Observabilidad ---------------------------------------------------------
# Sin estas keys la app funciona igual: el exporter de OTel queda en no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=                         # solo para armar el link de traza en el panel dev
EVAL_SAMPLE_RATE=0.0                         # 0.0-1.0; fraccion de turnos que se evaluan (P1)
